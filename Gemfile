source "https://rubygems.org"

# Pins the same versions GitHub Pages builds with, so a local build
# matches what gets deployed. GitHub ignores this file when building;
# it exists only for testing locally.
gem "github-pages", group: :jekyll_plugins

# Ruby 3 dropped webrick from stdlib, and `jekyll serve` needs it.
gem "webrick", "~> 1.8"
